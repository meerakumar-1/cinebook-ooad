@startuml class
skinparam classAttributeIconSize 0
enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

class User {
  +id: int
  +name: str
  -email: str
  +role(): str
}
class Customer {
  +phone: str
  +is_student: bool
  +role(): str
}
class Admin {
  +role(): str
}
User <|-- Customer
User <|-- Admin

class Theatre {
  +name: str
  +city: str
}
class Screen {
  +name: str
  +capacity(): int
  +seat_by_label(label: str): Seat
}
class Seat {
  +row: str
  +number: int
  +seat_type: SeatType
  +label(): str
}
class Movie {
  +title: str
  +duration_min: int
  +genre: str
  +language: str
  +rating: str
}
class Show {
  +start_time: datetime
  +base_price: float
  +end_time(): datetime
}
class Booking {
  -status: BookingStatus
  +created_at: datetime
  +total_amount(): float
  +confirm()
  +cancel()
  +expire()
}
class Ticket {
  +price: float
  +code: str
}
class Payment {
  +method: str
  +amount: float
  +status: str
  +txn_ref: str
}

Theatre "1" *-- "1..*" Screen : screens
Screen "1" *-- "1..*" Seat : seats
Movie "1" o-- "0..*" Show : shows
Screen "1" -- "0..*" Show : hosts >
Customer "1" -- "0..*" Booking : makes >
Show "1" -- "0..*" Booking : booked for <
Booking "1" *-- "1..*" Ticket : tickets
Ticket "0..*" -- "1" Seat : occupies >
Booking "1" -- "0..1" Payment : paid by >
Seat ..> SeatType
Booking ..> BookingStatus
@enduml
