@startuml factory_after
abstract class PaymentCreator {
  +{abstract} create_processor(): PaymentProcessor
  +process(amount, details)
}
class UPICreator
class CardCreator
class WalletCreator
abstract class PaymentProcessor {
  +{abstract} charge(amount, details): PaymentResult
}
class UPIProcessor
class CardProcessor
class WalletProcessor
PaymentCreator <|-- UPICreator
PaymentCreator <|-- CardCreator
PaymentCreator <|-- WalletCreator
PaymentProcessor <|-- UPIProcessor
PaymentProcessor <|-- CardProcessor
PaymentProcessor <|-- WalletProcessor
UPICreator ..> UPIProcessor : creates
CardCreator ..> CardProcessor : creates
WalletCreator ..> WalletProcessor : creates
PaymentCreator ..> PaymentProcessor
@enduml

