@startuml observer_after
class BookingEventPublisher {
  +subscribe(o)
  +unsubscribe(o)
  +notify(event, booking)
}
interface BookingObserver {
  +update(event, booking)
}
class EmailNotifier
class SMSNotifier
class AuditLogger
BookingEventPublisher o-- "0..*" BookingObserver
BookingObserver <|.. EmailNotifier
BookingObserver <|.. SMSNotifier
BookingObserver <|.. AuditLogger
BookingFacade --> BookingEventPublisher : notify()
@enduml

@startuml template_before
