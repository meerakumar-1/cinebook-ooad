  +revenue_report()
}
note right: one ad-hoc report; adding an occupancy report\nmeans copy-pasting the fetch/format/summary steps
@enduml

@startuml template_after
abstract class ReportGenerator <<template method>> {
  +generate()
  #{abstract} title()
  #{abstract} fetch_rows()
  #{abstract} format_row(row)
  #{abstract} summarise(rows)
}
class RevenueReport
class OccupancyReport
ReportGenerator <|-- RevenueReport
ReportGenerator <|-- OccupancyReport
@enduml
