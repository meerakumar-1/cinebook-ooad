@startuml usecase
left to right direction
actor Customer
actor Admin
actor "Payment Gateway" as PG <<system>>
rectangle CineBook {
  usecase "Register / Sign In" as UC0
  usecase "Browse Movies & Shows" as UC1
  usecase "View Seat Map" as UC2
  usecase "Book Tickets" as UC3
  usecase "Make Payment" as UC4
  usecase "Apply Pricing Rule" as UC5
  usecase "Cancel Booking" as UC6
  usecase "Refund Payment" as UC7
  usecase "View Booking History" as UC8
  usecase "Generate Report" as UC9
  usecase "Send Notification" as UC10
  usecase "View Notifications" as UC11
  usecase "Manage Movies" as UC12
  usecase "Schedule Show" as UC13
  usecase "Check Screen Conflicts" as UC14
}
Customer --> UC0
Admin --> UC0
Customer --> UC1
Customer --> UC3
Customer --> UC6
Customer --> UC8
Customer --> UC11
Admin --> UC9
Admin --> UC12
Admin --> UC13
UC3 ..> UC2 : <<include>>
UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC3 ..> UC10 : <<include>>
UC6 ..> UC10 : <<include>>
UC6 ..> UC7 : <<extend>>
UC13 ..> UC14 : <<include>>
UC4 --> PG
@enduml
