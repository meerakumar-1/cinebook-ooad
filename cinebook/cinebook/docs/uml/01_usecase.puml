@startuml usecase
left to right direction
actor Customer
actor Admin
actor "Payment Gateway" as PG <<system>>
rectangle CineBook {
  usecase "Browse Movies & Shows" as UC1
  usecase "View Seat Map" as UC2
  usecase "Book Tickets" as UC3
  usecase "Make Payment" as UC4
  usecase "Apply Pricing Rule" as UC5
  usecase "Cancel Booking" as UC6
  usecase "Refund Payment" as UC7
  usecase "View Booking History" as UC8
  usecase "Generate Report" as UC9
  usecase "Send Notification" as UC10
}
Customer --> UC1
Customer --> UC3
Customer --> UC6
Customer --> UC8
Admin --> UC9
UC3 ..> UC2 : <<include>>
UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC6 ..> UC7 : <<extend>>
UC3 ..> UC10 : <<include>>
UC6 ..> UC10 : <<include>>
UC4 --> PG
@enduml
