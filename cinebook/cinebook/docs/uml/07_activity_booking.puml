@startuml activity_booking
start
:Customer selects movie;
:Choose show;
:View seat map;
:Select seats;
if (seats available?) then (yes)
  :Compute price (pricing strategy);
  :Create PENDING booking;
  :Choose payment method;
  :Charge via payment processor;
  if (payment ok?) then (yes)
    :Confirm booking;
    :Notify customer (email/SMS);
  else (no)
    :Cancel booking, release seats;
    :Show error;
  endif
else (no)
  :Show "seat taken" error;
endif
stop
@enduml
